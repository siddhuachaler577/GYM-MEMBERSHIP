CREATE DATABASE IF NOT EXISTS gym_membership_db;
USE gym_membership_db;

SET FOREIGN_KEY_CHECKS = 0;

DROP TRIGGER IF EXISTS trg_attendance_join_date;
DROP TABLE IF EXISTS Payment;
DROP TABLE IF EXISTS Attendance;
DROP TABLE IF EXISTS Member;
DROP TABLE IF EXISTS MembershipPlan;
DROP TABLE IF EXISTS Trainer;

SET FOREIGN_KEY_CHECKS = 1;



 1. CREATE TABLES


CREATE TABLE Trainer (
    TrainerID INT PRIMARY KEY,
    TrainerName VARCHAR(80) NOT NULL,
    Specialization VARCHAR(50),
    ContactNo VARCHAR(15)
) ENGINE=InnoDB;


CREATE TABLE MembershipPlan (
    PlanID INT PRIMARY KEY,
    PlanName VARCHAR(40) NOT NULL UNIQUE,
    DurationMonths INT NOT NULL,
    Fee DECIMAL(8,2) NOT NULL
) ENGINE=InnoDB;


CREATE TABLE Member (
    MemberID INT PRIMARY KEY,
    FullName VARCHAR(80) NOT NULL,
    ContactNo VARCHAR(15) NOT NULL,
    Age INT NOT NULL,
    JoinDate DATE NOT NULL,
    PlanID INT NOT NULL,
    TrainerID INT NULL,

    CONSTRAINT fk_member_plan
        FOREIGN KEY (PlanID)
        REFERENCES MembershipPlan(PlanID)
        ON DELETE RESTRICT,

    CONSTRAINT fk_member_trainer
        FOREIGN KEY (TrainerID)
        REFERENCES Trainer(TrainerID)
        ON DELETE SET NULL
) ENGINE=InnoDB;


CREATE TABLE Attendance (
    MemberID INT NOT NULL,
    AttendanceDate DATE NOT NULL,
    CheckInTime TIME,

    PRIMARY KEY (MemberID, AttendanceDate),

    CONSTRAINT fk_attendance_member
        FOREIGN KEY (MemberID)
        REFERENCES Member(MemberID)
        ON DELETE RESTRICT
) ENGINE=InnoDB;


CREATE TABLE Payment (
    PaymentID INT PRIMARY KEY,
    MemberID INT NOT NULL,
    PaymentDate DATE NOT NULL,
    AmountPaid DECIMAL(8,2) NOT NULL,
    PaymentMode VARCHAR(20) NOT NULL,

    CONSTRAINT fk_payment_member
        FOREIGN KEY (MemberID)
        REFERENCES Member(MemberID)
        ON DELETE RESTRICT
) ENGINE=InnoDB;



-- 2. TRIGGER


DELIMITER $$

CREATE TRIGGER trg_attendance_join_date
BEFORE INSERT ON Attendance
FOR EACH ROW
BEGIN
    DECLARE v_join_date DATE;

    SELECT JoinDate
    INTO v_join_date
    FROM Member
    WHERE MemberID = NEW.MemberID;

    IF NEW.AttendanceDate < v_join_date THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
        'Attendance date cannot be earlier than Member JoinDate';
    END IF;
END$$

DELIMITER ;



