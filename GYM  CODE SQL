11. ATTENDANCE COUNT


SELECT
    m.MemberID,
    m.FullName,
    COUNT(a.AttendanceDate) AS AttendanceCount
FROM Member m
LEFT JOIN Attendance a
    ON m.MemberID = a.MemberID
GROUP BY m.MemberID, m.FullName
ORDER BY AttendanceCount DESC, m.MemberID;



 12. PAYMENT MODE SUMMARY


SELECT
    PaymentMode,
    COUNT(*) AS NumberOfPayments,
    SUM(AmountPaid) AS AmountCollected
FROM Payment
GROUP BY PaymentMode
ORDER BY AmountCollected DESC;


 
 13. SUBQUERY


SELECT
    MemberID,
    FullName,
    Age
FROM Member
WHERE Age > (
    SELECT AVG(Age)
    FROM Member
)
ORDER BY Age DESC;


 
 14. SUBQUERY - ABOVE AVERAGE PAYMENT
 

SELECT
    m.MemberID,
    m.FullName,
    SUM(p.AmountPaid) AS TotalPaid
FROM Member m
JOIN Payment p
    ON m.MemberID = p.MemberID
GROUP BY m.MemberID, m.FullName
HAVING SUM(p.AmountPaid) > (
    SELECT AVG(member_total)
    FROM (
        SELECT SUM(AmountPaid) AS member_total
        FROM Payment
        GROUP BY MemberID
    ) AS x
)
ORDER BY TotalPaid DESC;


 
 15. EXPIRY REPORT


SELECT
    m.MemberID,
    m.FullName,
    mp.PlanName,
    DATE_ADD(
        m.JoinDate,
        INTERVAL mp.DurationMonths MONTH
    ) AS ExpiryDate
FROM Member m
JOIN MembershipPlan mp
    ON m.PlanID = mp.PlanID
ORDER BY ExpiryDate;

 
