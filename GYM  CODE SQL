9. JOIN


SELECT
    m.MemberID,
    m.FullName,
    mp.PlanName,
    mp.Fee,
    COALESCE(t.TrainerName,'Not Assigned') AS TrainerName
FROM Member m
JOIN MembershipPlan mp
    ON m.PlanID = mp.PlanID
LEFT JOIN Trainer t
    ON m.TrainerID = t.TrainerID
ORDER BY m.MemberID;



 10. AGGREGATE


SELECT
    mp.PlanName,
    COUNT(m.MemberID) AS TotalMembers
FROM MembershipPlan mp
LEFT JOIN Member m
    ON mp.PlanID = m.PlanID
GROUP BY mp.PlanID, mp.PlanName
ORDER BY TotalMembers DESC;


